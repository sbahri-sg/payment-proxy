{
	admin 127.0.0.1:2019
	# Public TLS is handled by the existing reverse proxy, not this container.
	auto_https off
}

http://{$PAYMENT_PROXY_DOMAIN}:8080 {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	@payment_api path /api/v1/* /webhooks/v1/providers/* /health/live /health/ready
	handle @payment_api {
		reverse_proxy api:8080 {
			# Canonical public origin; never trust client-supplied forwarded headers.
			header_up Host {$PAYMENT_PROXY_DOMAIN}
			header_up X-Forwarded-Host {$PAYMENT_PROXY_DOMAIN}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy dashboard:3000 {
			# Keep HTTPS redirects and Secure session cookies behind TLS termination.
			header_up Host {$PAYMENT_PROXY_DOMAIN}
			header_up X-Forwarded-Host {$PAYMENT_PROXY_DOMAIN}
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output stdout
		format json
	}
}
