# Copy to .env, then replace every CHANGEME value. Never commit .env.
APP_ENV=development
API_PORT=18080
DASHBOARD_PORT=13000
CONNECTOR_RUNNER_PORT=18082
MIDTRANS_PROVIDER_APP_PORT=18083

POSTGRES_DB=payment_proxy
POSTGRES_USER=payment_proxy
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
DATABASE_URL=postgres://payment_proxy:CHANGEME_POSTGRES_PASSWORD@localhost:5432/payment_proxy?sslmode=disable
DATABASE_MAX_CONNECTIONS=40
DATABASE_MIN_CONNECTIONS=4
DATABASE_CONNECTION_MAX_LIFETIME_SECONDS=3600
DATABASE_CONNECTION_MAX_IDLE_SECONDS=300

# Per API replica. Production defaults are 300 RPS, burst 600, and 500
# concurrent service requests. Keep ingress/WAF limits enabled cluster-wide.
API_REQUEST_TIMEOUT_SECONDS=25
API_RATE_LIMIT_RPS=0
API_RATE_LIMIT_BURST=0
API_MAX_IN_FLIGHT=0

CREDENTIAL_ENCRYPTION_KEY=CHANGEME_BASE64_32_BYTES
SERVICE_API_KEY=CHANGEME_SERVICE_API_KEY
ADMIN_API_KEY=CHANGEME_ADMIN_API_KEY
DASHBOARD_MERCHANT_ID=merchant_dashboard_demo
DASHBOARD_ADMIN_PASSWORD=CHANGEME_DASHBOARD_ADMIN_PASSWORD
DASHBOARD_SESSION_SECRET=CHANGEME_RANDOM_32_BYTE_DASHBOARD_SESSION_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:13000
BACKEND_API_URL=http://localhost:18080

# Isolated connector runtimes. Payment Kernel communicates only through the
# authenticated universal contract. URL and token lists must have equal length.
CONNECTOR_RUNNER_BASE_URLS=http://connector-runner:18081,http://midtrans-provider-app:18083
CONNECTOR_RUNNER_TOKENS=CHANGEME_RANDOM_CONNECTOR_RUNNER_TOKEN,CHANGEME_RANDOM_MIDTRANS_PROVIDER_APP_TOKEN
CONNECTOR_RUNNER_TOKEN=CHANGEME_RANDOM_CONNECTOR_RUNNER_TOKEN
MIDTRANS_PROVIDER_APP_TOKEN=CHANGEME_RANDOM_MIDTRANS_PROVIDER_APP_TOKEN

# The public URL is used for direct provider webhooks and must be a stable HTTPS
# origin in production.
PAYMENT_PROXY_PUBLIC_BASE_URL=https://payments.example.com
ADMIN_RATE_LIMIT_RPS=20
ADMIN_RATE_LIMIT_BURST=40
# Public HTTPS page opened after Xendit sandbox customer authorization.
CERTIFICATION_RETURN_URL=https://dashboard.example.com/certifications/return
XENDIT_BASE_URL=https://api.xendit.co
MIDTRANS_SANDBOX_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_LIVE_BASE_URL=https://api.midtrans.com
CONNECTOR_TIMEOUT_SECONDS=15

# Canonical events delivered to the Emisell Backend receiver through the
# durable outbox. The URL must end at the Emisell Backend endpoint, for example
# https://api.emisell.com/webhooks/v1/payment-proxy. Never point production to
# the development contract receiver bundled in docker-compose.
# Legacy/bootstrap fallback only. The dashboard Webhooks menu can persist a
# manual Callback URL and generated whsec_ secret in the encrypted database.
# After database settings exist, the worker reads them without restart.
EMISELL_BACKEND_WEBHOOK_URL=
EMISELL_BACKEND_WEBHOOK_SECRET=
EMISELL_RECEIVER_MAX_SKEW_SECONDS=300
EMISELL_RECEIVER_PORT=19090

# Development only. Keep both false in production unless outbound traffic is
# protected by an explicit network allowlist.
WEBHOOK_ALLOW_INSECURE_HTTP=true
WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
WEBHOOK_POLL_INTERVAL_SECONDS=2
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_BASE_BACKOFF_SECONDS=5
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BATCH_SIZE=20
