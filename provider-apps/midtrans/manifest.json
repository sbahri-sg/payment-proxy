{
  "contract_version": "v1",
  "code": "midtrans",
  "name": "Midtrans",
  "version": "emisell-midtrans-v2.0.3",
  "runtime": "isolated_container",
  "sdk_version": "v1",
  "entrypoint": "connector",
  "operations": [
    "verify_installation",
    "disable_installation",
    "create_payment",
    "create_hosted_checkout",
    "get_payment",
    "handle_webhook"
  ],
  "credential_fields": [
