      "code": "server_key",
      "label": "Server key",
      "input_type": "password",
      "secret": true,
      "required": true
    },
    {
      "code": "pop_id",
      "label": "PoP ID (Core API)",
      "input_type": "password",
      "secret": true,
      "required": false
    }
  ],
